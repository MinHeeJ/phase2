<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sicost.memos.ProjectMemoMapper">
  <resultMap id="memoProjectState" type="com.sicost.memos.ProjectMemoModels$ProjectState">
    <constructor>
      <arg column="prj_id" javaType="_long"/>
      <arg column="cntrct_ty_cd" javaType="java.lang.String"/>
      <arg column="use_yn" javaType="java.lang.String"/>
      <arg column="prj_stts_cd" javaType="java.lang.String"/>
    </constructor>
  </resultMap>
  <resultMap id="memoRow" type="com.sicost.memos.ProjectMemoModels$MemoRow">
    <constructor>
      <arg column="memo_id" javaType="_long"/>
      <arg column="prj_id" javaType="_long"/>
      <arg column="wrt_dt" javaType="java.time.LocalDate"/>
      <arg column="actl_prgs_rt" javaType="java.math.BigDecimal"/>
      <arg column="cmpl_work_desc" javaType="java.lang.String"/>
      <arg column="plan_work_desc" javaType="java.lang.String"/>
      <arg column="rqst_desc" javaType="java.lang.String"/>
    </constructor>
  </resultMap>
  <select id="lockProject" resultMap="memoProjectState" flushCache="true" useCache="false">
    SELECT prj_id,cntrct_ty_cd,use_yn,prj_stts_cd FROM prj.prj WHERE prj_id=#{id} FOR UPDATE
  </select>
  <sql id="memoProjection">
    SELECT memo_id,prj_id,wrt_dt,actl_prgs_rt,cmpl_work_desc,plan_work_desc,rqst_desc
    FROM prj.wkly_memo WHERE prj_id=#{id}
  </sql>
  <select id="today" resultMap="memoRow" useCache="false">
    <include refid="memoProjection"/> AND wrt_dt=#{today} ORDER BY memo_id DESC LIMIT 1
  </select>
  <select id="latest" resultMap="memoRow" useCache="false">
    <include refid="memoProjection"/> ORDER BY wrt_dt DESC,memo_id DESC LIMIT 1
  </select>
  <select id="row" resultMap="memoRow" useCache="false">
    <include refid="memoProjection"/> AND memo_id=#{memoId}
  </select>
  <select id="insert" resultType="long" affectData="true" flushCache="true">
    INSERT INTO prj.wkly_memo(prj_id,wrt_dt,wrt_user_id,actl_prgs_rt,cmpl_work_desc,plan_work_desc,rqst_desc)
    VALUES(#{id},#{row.wrt_dt},#{actor},#{row.actl_prgs_rt},#{row.cmpl_work_desc},#{row.plan_work_desc},#{row.rqst_desc})
    RETURNING memo_id
  </select>
  <update id="update">
    UPDATE prj.wkly_memo SET actl_prgs_rt=#{row.actl_prgs_rt},cmpl_work_desc=#{row.cmpl_work_desc},
      plan_work_desc=#{row.plan_work_desc},rqst_desc=#{row.rqst_desc},updated_at=CURRENT_TIMESTAMP
    WHERE prj_id=#{id} AND memo_id=#{row.memo_id}
  </update>
</mapper>
