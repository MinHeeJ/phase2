<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sicost.dispatchattendance2.DispatchAttendanceUploadMapper">
  <resultMap id="project" type="com.sicost.dispatchattendance2.DispatchAttendanceUploadModels$Project">
    <constructor><arg column="type" javaType="java.lang.String"/><arg column="basis" javaType="java.lang.String"/><arg column="enabled" javaType="java.lang.String"/></constructor>
  </resultMap>
  <resultMap id="assignment" type="com.sicost.dispatchattendance2.DispatchAttendanceUploadModels$Assignment">
    <constructor>
      <arg column="asgn_id" javaType="_long"/><arg column="dev_id" javaType="_long"/>
      <arg column="mng_no" javaType="java.lang.String"/><arg column="dev_nm" javaType="java.lang.String"/>
      <arg column="assignment_mm" javaType="java.math.BigDecimal"/><arg column="price_available" javaType="_boolean"/>
    </constructor>
  </resultMap>
  <resultMap id="attendance" type="com.sicost.dispatchattendance2.DispatchAttendanceUploadModels$Attendance">
    <constructor>
      <arg column="atnd_id" javaType="java.lang.Long"/><arg column="asgn_id" javaType="_long"/><arg column="dev_id" javaType="_long"/>
      <arg column="work_day_qty" javaType="java.math.BigDecimal"/><arg column="rglr_tm_qty" javaType="java.math.BigDecimal"/>
      <arg column="ovtm_tm_qty" javaType="java.math.BigDecimal"/><arg column="mth_work_day_qty" javaType="java.math.BigDecimal"/>
    </constructor>
  </resultMap>
  <select id="project" resultMap="project" useCache="false" flushCache="true">
    SELECT cntrct_ty_cd AS type,stlm_mthd_cd AS basis,use_yn AS enabled FROM prj.prj WHERE prj_id=#{projectId}
  </select>
  <select id="assignments" resultMap="assignment" useCache="false" flushCache="true">
    SELECT a.asgn_id,a.dev_id,d.mng_no,d.dev_nm,m.mm_qty AS assignment_mm,
      (a.asgn_se_cd='FREE' OR EXISTS(SELECT 1 FROM asgn.untprc_hist h WHERE h.asgn_id=a.asgn_id
        AND h.aply_bgn_dt &lt;= greatest(#{first},a.bgn_dt) AND h.bill_untprc_amt IS NOT NULL
        AND h.aply_bgn_dt=(SELECT max(x.aply_bgn_dt) FROM asgn.untprc_hist x WHERE x.asgn_id=a.asgn_id AND x.aply_bgn_dt &lt;= greatest(#{first},a.bgn_dt)))) AS price_available
    FROM asgn.asgn a JOIN mst.dev d ON d.dev_id=a.dev_id
    LEFT JOIN asgn.asgn_mth m ON m.asgn_id=a.asgn_id AND m.work_ym=#{month}
    WHERE a.prj_id=#{projectId} AND a.asgn_stts_cd!='CANCELLED' AND d.use_yn='Y'
      AND a.bgn_dt &lt;= #{last} AND a.end_dt &gt;= #{first} ORDER BY a.asgn_id
  </select>
  <select id="billed" resultType="boolean" useCache="false" flushCache="true">
    SELECT EXISTS(SELECT 1 FROM bill.bill_dtl d JOIN bill.bill b ON b.bill_id=d.bill_id
      JOIN asgn.asgn a ON a.asgn_id=d.asgn_id
      WHERE a.prj_id=#{projectId} AND d.work_ym=#{month} AND b.bill_stts_cd='CONFIRM')
  </select>
  <select id="existing" resultMap="attendance" useCache="false" flushCache="true">
    SELECT atnd_id,asgn_id,dev_id,work_day_qty,rglr_tm_qty,ovtm_tm_qty,mth_work_day_qty
    FROM bill.dspch_atnd WHERE prj_id=#{projectId} AND work_ym=#{month} ORDER BY atnd_id
  </select>
  <delete id="delete">DELETE FROM bill.dspch_atnd WHERE prj_id=#{projectId} AND work_ym=#{month}</delete>
  <select id="insert" resultType="long" affectData="true" flushCache="true">
    INSERT INTO bill.dspch_atnd(work_ym,prj_id,dev_id,asgn_id,work_day_qty,rglr_tm_qty,ovtm_tm_qty,mth_work_day_qty,upld_id,created_by)
    VALUES(#{scope.month},#{scope.projectId},#{row.dev_id},#{row.asgn_id},#{row.work_day_qty},#{row.rglr_tm_qty},#{row.ovtm_tm_qty},#{row.mth_work_day_qty},#{upload},#{actor}) RETURNING atnd_id
  </select>
  <insert id="review">
    INSERT INTO sys.upld(upld_id,form_cd,scrn_id,obj_ym,obj_key_val,file_nm,file_path_addr,tot_row_cnt,nrml_row_cnt,err_row_cnt,wrn_row_cnt,upld_stts_cd,ovwr_yn,upld_user_id)
    VALUES(#{id},'B.3','UI-13',#{scope.month},CAST(#{scope.projectId} AS text),#{name},#{path},#{result.row_count},#{result.row_count}-#{result.error_count},#{result.error_count},#{result.warning_count},
      <choose><when test="result.can_apply">'APPLIED'</when><otherwise>'REJECTED'</otherwise></choose>,'Y',#{actor})
  </insert>
</mapper>
