<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sicost.dispatchattendance2.DispatchAttendanceUploadMapper">
  <resultMap id="project" type="com.sicost.dispatchattendance2.DispatchAttendanceUploadModels$Project">
    <constructor>
      <arg column="prj_id" javaType="_long"/>
      <arg column="cntrct_ty_cd" javaType="java.lang.String"/>
      <arg column="stlm_mthd_cd" javaType="java.lang.String"/>
      <arg column="use_yn" javaType="java.lang.String"/>
    </constructor>
  </resultMap>
  <resultMap id="source" type="com.sicost.dispatchattendance2.DispatchAttendanceUploadModels$Source">
    <constructor>
      <arg column="asgn_id" javaType="_long"/>
      <arg column="dev_id" javaType="_long"/>
      <arg column="mng_no" javaType="java.lang.String"/>
      <arg column="dev_nm" javaType="java.lang.String"/>
      <arg column="assignment_mm" javaType="java.math.BigDecimal"/>
      <arg column="price_available" javaType="_boolean"/>
    </constructor>
  </resultMap>
  <resultMap id="attendance" type="com.sicost.dispatchattendance2.DispatchAttendanceUploadModels$Attendance">
    <constructor>
      <arg column="atnd_id" javaType="java.lang.Long"/>
      <arg column="work_ym" javaType="java.lang.String"/>
      <arg column="prj_id" javaType="_long"/>
      <arg column="dev_id" javaType="_long"/>
      <arg column="asgn_id" javaType="java.lang.Long"/>
      <arg column="work_day_qty" javaType="java.math.BigDecimal"/>
      <arg column="rglr_tm_qty" javaType="java.math.BigDecimal"/>
      <arg column="ovtm_tm_qty" javaType="java.math.BigDecimal"/>
      <arg column="mth_work_day_qty" javaType="java.math.BigDecimal"/>
      <arg column="upld_id" javaType="java.lang.Long"/>
    </constructor>
  </resultMap>
  <select id="project" resultMap="project" useCache="false" flushCache="true">
    SELECT p.prj_id,p.cntrct_ty_cd,p.stlm_mthd_cd,p.use_yn FROM prj.prj p WHERE p.prj_id=#{id}
  </select>
  <select id="sources" resultMap="source" useCache="false" flushCache="true">
    SELECT a.asgn_id,a.dev_id,d.mng_no,d.dev_nm,m.mm_qty AS assignment_mm,
      (SELECT h.bill_untprc_amt IS NOT NULL FROM asgn.untprc_hist h
        WHERE h.asgn_id=a.asgn_id AND h.aply_bgn_dt &lt;= greatest(#{first},a.bgn_dt)
        ORDER BY h.aply_bgn_dt DESC LIMIT 1) IS TRUE AS price_available
    FROM asgn.asgn a JOIN mst.dev d ON d.dev_id=a.dev_id
    LEFT JOIN asgn.asgn_mth m ON m.asgn_id=a.asgn_id AND m.work_ym=#{month}
    WHERE a.prj_id=#{projectId} AND a.asgn_stts_cd&lt;&gt;'CANCELLED'
      AND a.bgn_dt&lt;=#{last} AND a.end_dt&gt;=#{first} AND d.use_yn='Y'
    ORDER BY a.asgn_id
  </select>
  <select id="monthStatus" resultType="string" useCache="false" flushCache="true">
    SELECT c.cls_stts_cd FROM fin.mth_cls c WHERE c.cls_ym=#{month}
  </select>
  <select id="confirmedUsage" resultType="boolean" useCache="false" flushCache="true">
    SELECT EXISTS(SELECT 1 FROM bill.bill_dtl d JOIN bill.bill b ON b.bill_id=d.bill_id
      WHERE b.prj_id=#{projectId} AND b.bill_stts_cd='CONFIRM' AND d.work_ym=#{month})
  </select>
  <select id="lockAttendance" resultMap="attendance" useCache="false" flushCache="true">
    SELECT a.atnd_id,a.work_ym,a.prj_id,a.dev_id,a.asgn_id,a.work_day_qty,a.rglr_tm_qty,
      a.ovtm_tm_qty,a.mth_work_day_qty,a.upld_id
    FROM bill.dspch_atnd a WHERE a.prj_id=#{projectId} AND a.work_ym=#{month}
    ORDER BY a.atnd_id FOR UPDATE
  </select>
  <delete id="deleteAttendance">
    DELETE FROM bill.dspch_atnd WHERE prj_id=#{projectId} AND work_ym=#{month}
  </delete>
  <select id="insertAttendance" resultType="long" affectData="true" flushCache="true">
    INSERT INTO bill.dspch_atnd(work_ym,prj_id,dev_id,asgn_id,work_day_qty,rglr_tm_qty,
      ovtm_tm_qty,mth_work_day_qty,upld_id,created_by)
    VALUES(#{row.work_ym},#{row.prj_id},#{row.dev_id},#{row.asgn_id},#{row.work_day_qty},
      #{row.rglr_tm_qty},#{row.ovtm_tm_qty},#{row.mth_work_day_qty},#{upload},#{actor}) RETURNING atnd_id
  </select>
  <insert id="insertUpload">
    INSERT INTO sys.upld(upld_id,form_cd,scrn_id,obj_ym,obj_key_val,file_nm,file_path_addr,
      tot_row_cnt,nrml_row_cnt,err_row_cnt,wrn_row_cnt,upld_stts_cd,ovwr_yn,upld_user_id)
    VALUES(#{id},'B.3','UI-13',#{scope.month},CAST(#{scope.projectId} AS text),#{name},#{path},
      #{result.row_count},#{result.row_count}-#{result.error_count},#{result.error_count},
      #{result.warning_count},#{status},#{overwrite},#{actor})
  </insert>
  <insert id="audit">
    INSERT INTO sys.data_chg_hist(tbl_nm,obj_rec_id,data_chg_ty_cd,bfr_val,aft_val,chg_user_id)
    VALUES('bill.dspch_atnd',#{id},#{type},#{before},#{after},#{actor})
  </insert>
  <insert id="access">
    INSERT INTO sys.acs_hist(user_id,acs_ty_cd,scrn_id,obj_desc,dtl_desc)
    VALUES(#{actor},#{type},'UI-13',#{display},#{detail})
  </insert>
</mapper>
