<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sicost.dispatchattendance2.DispatchAttendanceUploadMapper">
  <resultMap id="project" type="com.sicost.dispatchattendance2.DispatchAttendanceUploadModels$Project">
    <constructor>
      <arg column="cntrct_ty_cd" javaType="java.lang.String"/>
      <arg column="stlm_mthd_cd" javaType="java.lang.String"/>
      <arg column="use_yn" javaType="java.lang.String"/>
    </constructor>
  </resultMap>
  <resultMap id="source" type="com.sicost.dispatchattendance2.DispatchAttendanceUploadModels$Source">
    <constructor>
      <arg column="asgn_id" javaType="_long"/>
      <arg column="dev_id" javaType="_long"/>
      <arg column="mng_no" javaType="java.lang.String"/>
      <arg column="dev_nm" javaType="java.lang.String"/>
      <arg column="assignment_mm" javaType="java.math.BigDecimal"/>
      <arg column="price_available" javaType="_boolean"/>
    </constructor>
  </resultMap>
  <resultMap id="stored" type="com.sicost.dispatchattendance2.DispatchAttendanceUploadModels$Stored">
    <constructor>
      <arg column="atnd_id" javaType="_long"/>
      <arg column="dev_id" javaType="_long"/>
      <arg column="asgn_id" javaType="java.lang.Long"/>
      <arg column="work_day_qty" javaType="java.math.BigDecimal"/>
      <arg column="rglr_tm_qty" javaType="java.math.BigDecimal"/>
      <arg column="ovtm_tm_qty" javaType="java.math.BigDecimal"/>
      <arg column="mth_work_day_qty" javaType="java.math.BigDecimal"/>
      <arg column="upld_id" javaType="java.lang.Long"/>
    </constructor>
  </resultMap>
  <select id="nextUploadId" resultType="long">SELECT nextval('sys.seq_upld_id')</select>
  <select id="project" resultMap="project">
    SELECT p.cntrct_ty_cd,p.stlm_mthd_cd,p.use_yn FROM prj.prj p WHERE p.prj_id=#{id}
  </select>
  <select id="lockProject" resultMap="project">
    SELECT p.cntrct_ty_cd,p.stlm_mthd_cd,p.use_yn FROM prj.prj p WHERE p.prj_id=#{id} FOR UPDATE
  </select>
  <select id="monthStatus" resultType="string">
    SELECT c.cls_stts_cd FROM fin.mth_cls c WHERE c.cls_ym=#{month}
  </select>
  <select id="sources" resultMap="source">
    SELECT a.asgn_id,a.dev_id,d.mng_no,d.dev_nm,m.mm_qty AS assignment_mm,
      ((SELECT h.bill_untprc_amt FROM asgn.untprc_hist h
        WHERE h.asgn_id=a.asgn_id AND h.aply_bgn_dt &lt;= greatest(#{firstDay},a.bgn_dt)
        ORDER BY h.aply_bgn_dt DESC LIMIT 1) IS NOT NULL) AS price_available
    FROM asgn.asgn a JOIN mst.dev d ON d.dev_id=a.dev_id
    LEFT JOIN asgn.asgn_mth m ON m.asgn_id=a.asgn_id AND m.work_ym=#{month}
    WHERE a.prj_id=#{projectId} AND a.asgn_stts_cd!='CANCELLED'
      AND a.bgn_dt &lt;= #{lastDay} AND a.end_dt &gt;= #{firstDay}
    ORDER BY a.dev_id,a.asgn_id
  </select>
  <select id="confirmedUse" resultType="boolean">
    SELECT EXISTS(SELECT 1 FROM bill.bill b JOIN bill.bill_dtl d ON d.bill_id=b.bill_id
      WHERE b.prj_id=#{projectId} AND b.bill_stts_cd='CONFIRM' AND d.work_ym=#{month}
        AND d.asgn_id IS NOT NULL)
  </select>
  <select id="lockAttendance" resultMap="stored">
    SELECT t.atnd_id,t.dev_id,t.asgn_id,t.work_day_qty,t.rglr_tm_qty,t.ovtm_tm_qty,
      t.mth_work_day_qty,t.upld_id
    FROM bill.dspch_atnd t WHERE t.prj_id=#{projectId} AND t.work_ym=#{month}
    ORDER BY t.dev_id,t.atnd_id FOR UPDATE
  </select>
  <select id="uploadStatus" resultType="string">
    SELECT u.upld_stts_cd FROM sys.upld u WHERE u.upld_id=#{id} AND u.form_cd='B.3'
  </select>
  <insert id="insertReview">
    INSERT INTO sys.upld(upld_id,form_cd,scrn_id,obj_ym,obj_key_val,file_nm,file_path_addr,
      tot_row_cnt,nrml_row_cnt,err_row_cnt,wrn_row_cnt,upld_stts_cd,ovwr_yn,upld_user_id)
    VALUES(#{review.id},'B.3','UI-13',#{review.scope.month},CAST(#{review.scope.projectId} AS text),
      #{review.name},#{review.path},#{result.row_count},greatest(0,#{result.row_count}-#{result.error_count}),
      #{result.error_count},#{result.warning_count},#{status},'Y',#{actor})
  </insert>
  <delete id="deleteAttendance">
    DELETE FROM bill.dspch_atnd WHERE prj_id=#{projectId} AND work_ym=#{month}
  </delete>
  <select id="insertAttendance" resultType="long" affectData="true" flushCache="true">
    INSERT INTO bill.dspch_atnd(work_ym,prj_id,dev_id,asgn_id,work_day_qty,rglr_tm_qty,
      ovtm_tm_qty,mth_work_day_qty,upld_id,created_by)
    VALUES(#{scope.month},#{scope.projectId},#{row.dev_id},#{row.asgn_id},#{row.work_day_qty},
      #{row.rglr_tm_qty},#{row.ovtm_tm_qty},#{row.mth_work_day_qty},#{uploadId},#{actor})
    RETURNING atnd_id
  </select>
  <insert id="audit">
    INSERT INTO sys.data_chg_hist(tbl_nm,obj_rec_id,data_chg_ty_cd,clmn_nm,bfr_val,aft_val,chg_user_id)
    VALUES('bill.dspch_atnd',#{id},#{type},'파견 근태',#{before},#{after},#{actor})
  </insert>
  <insert id="access">
    INSERT INTO sys.acs_hist(user_id,acs_ty_cd,scrn_id,obj_desc,dtl_desc)
    VALUES(#{actor},#{type},'UI-13',#{display},#{detail})
  </insert>
</mapper>
